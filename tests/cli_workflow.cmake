file(MAKE_DIRECTORY "${WORK_DIR}")
file(REMOVE "${WORK_DIR}/migrated.bin" "${WORK_DIR}/middle.bin" "${WORK_DIR}/staged.bin")
function(expect_cli expected)
    execute_process(COMMAND "${CLI}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(NOT status EQUAL expected)
        message(FATAL_ERROR "CLI ${ARGN}: expected ${expected}, got ${status}\n${output}${diagnostic}")
    endif()
    set(LAST_OUTPUT "${output}" PARENT_SCOPE)
endfunction()
expect_cli(0 inspect "${GOLDEN_DIR}/scene_v1.bin")
if(NOT LAST_OUTPUT MATCHES "Player type=2 schema=1")
    message(FATAL_ERROR "Missing Player V1 inspect metadata")
endif()
expect_cli(0 validate "${GOLDEN_DIR}/scene_v1.bin")
expect_cli(0 migrate "${GOLDEN_DIR}/scene_v1.bin" "${WORK_DIR}/migrated.bin")
expect_cli(0 validate "${WORK_DIR}/migrated.bin")
expect_cli(1 diff "${GOLDEN_DIR}/scene_v1.bin" "${WORK_DIR}/migrated.bin")
expect_cli(0 to-json "${WORK_DIR}/migrated.bin")
if(NOT LAST_OUTPUT MATCHES "Unknown")
    message(FATAL_ERROR "Migration did not supply the default player name")
endif()
expect_cli(2 validate "${GOLDEN_DIR}/bad_magic.bin")
expect_cli(2 validate "${GOLDEN_DIR}/truncated.bin")
expect_cli(3 migrate "${GOLDEN_DIR}/scene_v1.bin" "${WORK_DIR}/migrated.bin")

expect_cli(0 migrate "${GOLDEN_DIR}/scene_v1.bin" "${WORK_DIR}/middle.bin" --to-version 2)
expect_cli(0 migrate "${WORK_DIR}/middle.bin" "${WORK_DIR}/staged.bin" --to-version 3)
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${WORK_DIR}/staged.bin" "${WORK_DIR}/migrated.bin" RESULT_VARIABLE equal)
if(NOT equal EQUAL 0)
    message(FATAL_ERROR "Direct and staged V3 migrations differ")
endif()
expect_cli(0 inspect "${WORK_DIR}/staged.bin")
if(NOT LAST_OUTPUT MATCHES "Stats type=5 schema=1")
    message(FATAL_ERROR "Missing V3 Stats structure")
endif()
expect_cli(4 migrate "${WORK_DIR}/staged.bin" "${WORK_DIR}/unused.bin")
